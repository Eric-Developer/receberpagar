{
  "expo": {
    "name": "Fluxo",
    "slug": "pagar-receber",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo_icon.png",
    "scheme": "fluxo",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ericdeveloper.pagarreceber"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_icon.png"
    },

    "splash": {
      "image": "./assets/images/logo_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A",
      "dark": {
        "backgroundColor": "#020617"
      }
    },

    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#020617"
          },
          "imageWidth": 200
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee62e994-1c73-494b-8474-3c21b3b66f19"
      }
    }
  }
}
